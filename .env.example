# API
API_HOST=127.0.0.1
API_PORT=8080

# MySQL
MYSQL_PORT=3306
MYSQL_DATABASE=instant_chat
MYSQL_USER=instant_chat
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=instant-chat-files
MINIO_USE_TLS=false

# Go database connection
DATABASE_DSN='instant_chat:change-me@tcp(127.0.0.1:3306)/instant_chat?charset=utf8mb4&parseTime=true&loc=UTC'

# golang-migrate connection
MIGRATION_DATABASE_URL='mysql://instant_chat:change-me@tcp(127.0.0.1:3306)/instant_chat'
